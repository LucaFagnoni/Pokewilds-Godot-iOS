static func info(species: String) -> Dictionary:
    var key := species.to_lower()
    var imported := PokemonData.info(key)
    if not imported.is_empty():
        if imported.get("harvest", []).is_empty():
            imported.erase("harvest")
        return imported
    if SPECIES.has(key):
        return (SPECIES[key] as Dictionary).duplicate(true)
    return {"types":["NORMAL"], "special":[], "fully_evolved":false}

static func types_for(species: String) -> Array[String]:
    var result: Array[String] = []
    for raw in info(species).get("types", ["NORMAL"]):
        result.append(String(raw))
    return result

static func field_moves_for(species: String, form: String = "") -> Array[String]:
    var base_species := String(info(species).get("mega_base_species", ""))
    if not base_species.is_empty(): species = base_species
    var result: Array[String] = []
    var data := info(species)
    for pokemon_type in types_for(species):
        if TYPE_DEFAULT_MOVE.has(pokemon_type):
            var move := String(TYPE_DEFAULT_MOVE[pokemon_type])
            if not result.has(move):
                result.append(move)
    # Surf is the Water-type default only for final evolutions.
    if types_for(species).has("WATER") and bool(data.get("fully_evolved", false)):
        if not result.has("SURF"):
            result.append("SURF")
    for raw in data.get("special", []):
        var move := String(raw)
        if move == "PAINT" and species.to_lower() != "smeargle":
            continue
        if not result.has(move):
            result.append(move)
    if species.to_lower() == "gengar" and form.to_lower() == "mega" and not result.has("TELEPORT"):
        result.append("TELEPORT")
    var ordered: Array[String] = []
    for move_name in FIELD_MOVE_ORDER:
        if result.has(move_name):
            ordered.append(move_name)
    return ordered

static func habitat_requirements(species: String) -> Array[String]:
    return PokemonEcology.habitat_groups(species)

static func harvest_items(species: String) -> Array[String]:
    return PokemonEcology.harvest_items(species)

static func is_fully_evolved(species: String) -> bool:
    return bool(info(species).get("fully_evolved", false))

static func dig_material(base_name: String, upper_name: String, biome: String, route_name: String = "") -> String:
    # PlayerStanding terrain precedence uses the actual tile, not its biome.
    if "ledges3" in upper_name: return "HARD STONE"
    if "sand" in base_name or base_name == "stalagmite1": return "SOFT SAND"
    if "snow" in base_name or "ice" in base_name: return "NEVERMELTICE"
    if "mountain" in base_name: return "LIGHT CLAY"
    if "desert" in base_name: return "DRY SAND"
    if "flower" in base_name: return "FLOWERS"
    if "volcano" in base_name or "soot" in base_name: return "ASHEN SOIL"
    if base_name == "green9" or "green10" in base_name or "green11" in base_name or "green12" in base_name: return "CURSED SOIL"
    if "ledges3" in base_name: return "HARD STONE"
    if "green_savanna" in base_name: return "DRY SOIL"
    if route_name == "wooded_lake1": return "DAMP SOIL"
    if route_name == "deep_forest": return "MYSTIC SOIL"
    return "GRASS"

static func dig_choice_info(choice: String) -> Dictionary:
    return (DIG_TERRAIN.get(choice.to_upper(), {}) as Dictionary).duplicate(true)

static func cracked_loot(tile_name: String) -> Array:
    var key := tile_name.to_lower()
    return (CRACKED_LOOT.get(key, []) as Array).duplicate()

static func biome_dig_loot(biome: String, route_name: String = "") -> Array:
    var key := biome.strip_edges().to_upper().replace(" ", "_")
    if key == "TUNDRA":
        key = "SNOW"
    var route := route_name.to_lower()
    if key == "BEACH" and route.begins_with("beach2"):
        return TIDAL_BEACH_DIG_LOOT.duplicate()
    return (BIOME_DIG_LOOT.get(key, []) as Array).duplicate()

# CycleDayNight uses distinct identities even though Tile.init draws all cracks
# with the same desert4_cracked image. Preserve their reward-table identity.
static func dig_site_name(tile: SourceTile, legacy_biome: String = "") -> String:
    # CycleDayNight ground tests, in source order. Biome fallback is only for
    # restoring older port-created sites on its broader candidate surfaces.
    if "desert" in tile.name: return "desert4_cracked"
    if tile.name in ["green11", "green12"]: return "graveyard_cracked"
    if tile.name == "green1":
        return "deepforest_cracked" if tile.biome == "deep_forest" else "forest_cracked"
    if tile.name == "sand1": return "beach_cracked"
    if tile.name == "mountain3": return "mountain3_cracked"
    if tile.name in ["snow1", "snow2", "snow5", "snow6"]: return "snow_cracked"
    if tile.name == "volcano1": return "volcano_cracked"
    if "_tidal" in tile.name: return "tidal1_cracked"
    return String({
        "DESERT":"desert4_cracked", "FOREST":"forest_cracked",
        "DEEP_FOREST":"deepforest_cracked", "GRAVEYARD":"graveyard_cracked",
        "SNOW":"snow_cracked", "TUNDRA":"snow_cracked",
        "VOLCANO":"volcano_cracked", "BEACH":"beach_cracked",
        "MOUNTAIN":"mountain3_cracked"
    }.get(legacy_biome, ""))

static func apply_dig_terrain(tile: SourceTile, choice: String) -> void:
    # PlayerStanding terrain placement, including Tile.guessBiomeType's exact
    # green1 biome/forest1 route combination. FLOWERS retains its prior route.
    var info := dig_choice_info(choice)
    if choice == "CLIFF":
        var ledge := "ledges3_none"
        if "snow" in tile.name or "ice" in tile.name: ledge = "ledges3snow_none"
        elif "volcano" in tile.name or "soot" in tile.name: ledge = "ledges3volcano_none"
        tile.set_names(tile.name, ledge)
        return
    var names := {
        "BEACH SAND":["beach", "beach2"], "DESERT":["desert", "desert1"],
        "MOUNTAIN":["mountain", "mountain1"], "SNOW":["tundra", "snow1"],
        "FOREST":["savanna", "forest1"], "VOLCANO":["volcano", "volcano1"],
        "GRAVEYARD":["graveyard", "graveyard1"], "SAVANNA":["savanna", "savanna2"],
        "WOODED LAKE":["wooded_lake", "wooded_lake1"], "DEEP FOREST":["deep_forest", "deep_forest"]
    }
    tile.set_names("green1" if choice in ["WOODED LAKE", "DEEP FOREST"] else String(info.base), "")
    if names.has(choice):
        tile.biome = String(names[choice][0])
        tile.route_belongs_to = SourceRoute.new(String(names[choice][1]), 22)

static func adjust_dig_cliff(tile: SourceTile, tiles: Dictionary) -> void:
    # PkmnMap.ledgify(Tile), applied only to the placed CLIFF tile.
    var at := tile.position
    var offsets := {"left":Vector2i(-16,0), "right":Vector2i(16,0),
        "up":Vector2i(0,16), "down":Vector2i(0,-16),
        "bl":Vector2i(-16,-16), "br":Vector2i(16,-16),
        "tl":Vector2i(-16,16), "tr":Vector2i(16,16)}
    var n := {}
    for key in offsets:
        var other: SourceTile = tiles.get(at + offsets[key])
        n[key] = other != null and "ledges3" in other.name_upper
    var suffix := ""
    if n.left and not n.down and n.right: suffix = "_N"
    elif n.up and n.right and not n.down and not n.left: suffix = "_NE"
    elif n.up and not n.left and n.down: suffix = "_E"
    elif not n.up and not n.left and n.right and n.down: suffix = "_SE"
    elif not n.up and n.left and n.right: suffix = "_S"
    elif not n.up and n.down and n.left and not n.right: suffix = "_SW"
    elif n.up and n.down and not n.right: suffix = "_W"
    elif n.up and n.left and not n.down and not n.right: suffix = "_NW"
    elif not n.br and n.down and n.right: suffix = "_NW_inner"
    elif not n.bl and n.down and n.left: suffix = "_NE_inner"
    elif not n.tr and n.up and n.right: suffix = "_SW_inner"
    elif not n.tl and n.up and n.left: suffix = "_SE_inner"
    if not suffix.is_empty():
        var prefix := "ledges3snow" if "snow" in tile.name_upper else "ledges3volcano" if "volcano" in tile.name_upper else "ledges3"
        tile.set_names(tile.name, prefix + suffix)
