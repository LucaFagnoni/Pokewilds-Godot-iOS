]

static func verify_java_random() -> bool:
    for seed_value in RAW:
        var raw_random := SourceJavaRandom.new(int(seed_value))
        for expected in RAW[seed_value]:
            if raw_random.next_int() != int(expected):
                return false
        var bounded_random := SourceJavaRandom.new(int(seed_value))
        for index in range(BOUNDS.size()):
            if bounded_random.next_int(BOUNDS[index]) != int(BOUNDED[seed_value][index]):
                return false
    return true

static func verify_java_hash_map_order() -> bool:
    var source: Dictionary = {}
    for index in range(HASH_MAP_INSERTION_POINTS.size()):
        source[HASH_MAP_INSERTION_POINTS[index]] = index
    return SourceJavaHashOrder.keys(source) == HASH_MAP_EXPECTED_ORDER

static func verify_java_rotation_degrees() -> bool:
    for index in range(ROTATION_DEGREES.size()):
        var actual := Vector2(37.0, -91.0).rotated(
            deg_to_rad(ROTATION_DEGREES[index])
        )
        if not actual.is_equal_approx(ROTATION_EXPECTED[index]):
            return false
    return true

static func verify_java_maze_2() -> bool:
    var maze := SourceMaze.maze_algo2(
        9, 7, 0.32, 0.32, SourceJavaRandom.new(81102)
    )
    if maze.size() != 10 or (maze[0] as Array).size() != 8:
        return false
    for y in range(MAZE_2_81102_ROWS.size()):
        var row := ""
        for x in range(maze.size()):
            row += "1" if bool(maze[x][y]) else "0"
        if row != String(MAZE_2_81102_ROWS[y]):
            return false
    return true
