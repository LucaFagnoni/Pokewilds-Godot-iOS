const MAZE_2_81102_ROWS := [
    "1111111111", "1000000010", "1110111010", "1010001010",
    "1011111010", "1000000010", "1111111111", "1000000010"
]
const ROTATION_DEGREES := [180.0, 90.0, 45.0, -15.0, 27.0, -27.0]
const ROTATION_EXPECTED := [
    Vector2(-37.000007629, 91.0),
    Vector2(91.0, 37.000003815),
    Vector2(90.509666443, -38.183769226),
    Vector2(12.186721802, -97.475547791),
