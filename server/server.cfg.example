; PokeWilds dedicated server settings. Copy this file to server.cfg next to
; PokeWilds.exe and change what you need. Command-line options
; (--port, --world, --size, --accounts, --password) win over this file.
[server]
; TCP port players connect to. Open it on the firewall and the router.
port=54555
; World name: the server loads the world with this name, or creates it.
world="PokeWilds"
; Size of a new world: S, M, L, XL or XXL.
size="M"
; Player IDs: "open" (a first login makes the ID), "closed" (only IDs made
; with `account add` in the server window) or "off" (no IDs, as before).
accounts="open"
; Shared password, only used with accounts="off". Empty = anyone can join.
password=""
; Players at once (1-8). `maxplayers N` in the server window changes it live.
max_players=4
; Show the server in the phones' JOIN GAME list (true/false). The port must be
; reachable from outside. `list on` / `list off` in the server window change it.
listed=false
; Minutes between automatic saves.
autosave_minutes=5
; Open the port on the router by itself (UPnP) while the server runs.
open_router_port=true
; Take a wild battle's win or catch only when the server's own replay of the
; battle ends the same way, with no more experience (true/false).
enforce_battles=true
; Who moves the wild and habitat Pokemon and lays the eggs in the areas players
; are in: "server" (this server, in every area: the players' phones only show
; them) or "players" (the first player in each area, as when a phone hosts).
population_authority="server"
; New areas: made in the server's own process on a worker thread ("auto": when
; the engine has the native world generator; "on": always, the GDScript
; generator is slower but still off the server's frame), or by a second copy of
; the server started for each one ("off").
area_generation="auto"
